<%- include('partials/header') %>
<% const pageTitle = 'Edit Profile'; %>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="fw-bold mb-0">Edit Profile</h2>
                    <a href="/profile/<%= profile.id %>" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-eye me-1"></i>View Profile
                    </a>
                </div>
                <div id="profileAlert" class="alert d-none"></div>
                <div class="card glass-card p-4 mb-4">
                    <form id="profileForm">
                        <div class="row g-3">
                            <div class="col-12 text-center mb-3">
                                <img src="<%= profile.avatar_url %>" class="rounded-circle mb-3" width="100" height="100" id="avatarPreview" alt="Avatar">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Full Name</label>
                                <input type="text" class="form-control" id="editName" value="<%= profile.name %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Email</label>
                                <input type="email" class="form-control" id="editEmail" value="<%= profile.email %>" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Location</label>
                                <input type="text" class="form-control" id="editLocation" value="<%= profile.location || '' %>" placeholder="City, State">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Hourly Rate ($)</label>
                                <input type="number" class="form-control" id="editRate" value="<%= profile.hourly_rate %>" placeholder="0">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Avatar URL</label>
                                <input type="url" class="form-control" id="editAvatar" value="<%= profile.avatar_url %>" placeholder="https://...">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Skills</label>
                                <input type="text" class="form-control" id="editSkills" value="<%= profile.skills || '' %>" placeholder="JavaScript, React, Node.js (comma separated)">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Bio</label>
                                <textarea class="form-control" id="editBio" rows="6" placeholder="Tell us about yourself..."><%= profile.bio || '' %></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-warning fw-semibold px-4">
                                    <i class="bi bi-check-lg me-1"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.getElementById('editAvatar').addEventListener('input', function() {
    document.getElementById('avatarPreview').src = this.value;
});

document.getElementById('profileForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const alert = document.getElementById('profileAlert');
    try {
        const res = await fetch('/api/v1/users/<%= profile.id %>', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: document.getElementById('editName').value,
                email: document.getElementById('editEmail').value,
                location: document.getElementById('editLocation').value,
                hourly_rate: document.getElementById('editRate').value,
                avatar_url: document.getElementById('editAvatar').value,
                skills: document.getElementById('editSkills').value,
                bio: document.getElementById('editBio').value
            })
        });
        const data = await res.json();
        if (res.ok) {
            alert.className = 'alert alert-success';
            alert.textContent = 'Profile updated successfully!';
        } else {
            alert.className = 'alert alert-danger';
            alert.textContent = data.error;
        }
    } catch (err) {
        alert.className = 'alert alert-danger';
        alert.textContent = 'Failed to update profile';
    }
});
</script>

<%- include('partials/footer') %>
