<%- include('partials/header') %>
<% const pageTitle = 'My Applications'; %>

<section class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">My Applications</h2>
        <div id="applicationsContent">
            <div class="text-center py-5">
                <div class="spinner-border text-warning" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    try {
        const res = await fetch('/api/v1/applications');
        const apps = await res.json();

        if (apps.length === 0) {
            document.getElementById('applicationsContent').innerHTML = `
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-text fs-1 text-muted"></i>
                    <h5 class="text-muted mt-3">No applications yet</h5>
                    <p class="text-muted">Start applying to jobs to track your proposals here.</p>
                    <a href="/jobs" class="btn btn-warning">Browse Jobs</a>
                </div>`;
            return;
        }

        document.getElementById('applicationsContent').innerHTML = `
            <div class="card glass-card">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Job Title</th>
                                <th>Proposed Rate</th>
                                <th>Status</th>
                                <th>Budget Range</th>
                                <th>Applied</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            ${apps.map(app => `
                                <tr>
                                    <td>
                                        <a href="/jobs/${app.job_id}" class="text-decoration-none fw-semibold">${escapeHtml(app.job_title)}</a>
                                    </td>
                                    <td class="text-success fw-semibold">$${Number(app.proposed_rate).toLocaleString()}</td>
                                    <td>
                                        <span class="badge bg-${app.status === 'accepted' ? 'success' : app.status === 'rejected' ? 'danger' : app.status === 'withdrawn' ? 'secondary' : 'warning'} bg-opacity-25 text-${app.status === 'accepted' ? 'success' : app.status === 'rejected' ? 'danger' : app.status === 'withdrawn' ? 'secondary' : 'warning'}">
                                            ${app.status.charAt(0).toUpperCase() + app.status.slice(1)}
                                        </span>
                                    </td>
                                    <td class="text-muted">$${Number(app.budget_min).toLocaleString()} — $${Number(app.budget_max).toLocaleString()}</td>
                                    <td class="text-muted small">${new Date(app.created_at).toLocaleDateString()}</td>
                                    <td><a href="/jobs/${app.job_id}" class="btn btn-outline-warning btn-sm">View Job</a></td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
            </div>`;
    } catch (err) {
        document.getElementById('applicationsContent').innerHTML = `
            <div class="text-center py-5">
                <i class="bi bi-exclamation-circle fs-1 text-danger"></i>
                <h5 class="text-muted mt-3">Failed to load applications</h5>
            </div>`;
    }
});

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
</script>

<%- include('partials/footer') %>
