<%- include('partials/header') %>
<% const pageTitle = 'Admin Dashboard'; %>

<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2 text-warning"></i>Admin Dashboard</h2>
                <p class="text-muted mb-0">Manage users and platform settings</p>
            </div>
        </div>

        <div class="card glass-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0" id="usersTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Location</th>
                                <th>Joined</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody">
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="spinner-border text-warning" role="status"></div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', loadUsers);

async function loadUsers() {
    try {
        const res = await fetch('/api/v1/admin/users');
        const users = await res.json();

        document.getElementById('usersTableBody').innerHTML = users.map(u => `
            <tr id="user-row-${u.id}">
                <td>${u.id}</td>
                <td>
                    <div class="d-flex align-items-center">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(u.name)}" class="rounded-circle me-2" width="32" height="32" alt="">
                        <a href="/profile/${u.id}" class="text-decoration-none fw-semibold">${escapeHtml(u.name)}</a>
                    </div>
                </td>
                <td class="text-muted">${escapeHtml(u.email)}</td>
                <td>
                    <select class="form-select form-select-sm" style="width: auto;" onchange="updateRole(${u.id}, this.value)">
                        <option value="user" ${u.role === 'user' ? 'selected' : ''}>User</option>
                        <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>Admin</option>
                    </select>
                </td>
                <td class="text-muted small">${escapeHtml(u.location || 'N/A')}</td>
                <td class="text-muted small">${new Date(u.created_at).toLocaleDateString()}</td>
                <td>
                    <button class="btn btn-outline-danger btn-sm" onclick="deleteUser(${u.id})">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `).join('');
    } catch (err) {
        document.getElementById('usersTableBody').innerHTML = `
            <tr><td colspan="7" class="text-center text-danger py-4">Failed to load users</td></tr>`;
    }
}

async function updateRole(userId, role) {
    try {
        await fetch(`/api/v1/admin/users/${userId}/role`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ role })
        });
    } catch (err) {
        alert('Failed to update role');
    }
}

async function deleteUser(userId) {
    if (!confirm('Are you sure you want to delete this user? This action cannot be undone.')) return;
    try {
        const res = await fetch(`/api/v1/admin/users/${userId}`, { method: 'DELETE' });
        if (res.ok) {
            document.getElementById(`user-row-${userId}`).remove();
        }
    } catch (err) {
        alert('Failed to delete user');
    }
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
</script>

<%- include('partials/footer') %>
