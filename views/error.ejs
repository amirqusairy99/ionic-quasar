<%- include('partials/header') %>
<% const pageTitle = 'Error'; %>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center py-5">
                <i class="bi bi-exclamation-triangle fs-1 text-warning mb-3 d-block"></i>
                <h2 class="fw-bold mb-3">Oops! Something went wrong</h2>
                <p class="text-muted mb-4"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred. Please try again later.' %></p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-warning px-4">
                        <i class="bi bi-house me-1"></i>Go Home
                    </a>
                    <a href="/jobs" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-briefcase me-1"></i>Browse Jobs
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
