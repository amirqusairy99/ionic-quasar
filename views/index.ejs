<%- include('partials/header') %>
<% const pageTitle = 'Home'; %>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-7">
                <div class="hero-badge mb-3">
                    <span class="badge bg-warning bg-opacity-25 text-warning px-3 py-2 rounded-pill">
                        <i class="bi bi-stars me-1"></i> #1 Freelance Marketplace
                    </span>
                </div>
                <h1 class="display-3 fw-800 mb-4 hero-title">
                    Find the perfect <span class="text-gradient">freelance</span> talent for your project
                </h1>
                <p class="lead text-muted mb-4 pe-lg-5">
                    Connect with top professionals across development, design, marketing, and more. Post a job and start receiving proposals in minutes.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a href="/jobs" class="btn btn-warning btn-lg px-4 fw-semibold">
                        <i class="bi bi-search me-2"></i>Find Talent
                    </a>
                    <a href="/auth/register" class="btn btn-outline-light btn-lg px-4">
                        <i class="bi bi-rocket-takeoff me-2"></i>Start Freelancing
                    </a>
                </div>
                <div class="d-flex align-items-center gap-4 mt-4">
                    <div class="d-flex">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=john" class="rounded-circle border border-2 border-dark" width="36" height="36" style="margin-right:-10px;z-index:3">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=jane" class="rounded-circle border border-2 border-dark" width="36" height="36" style="margin-right:-10px;z-index:2">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=marcus" class="rounded-circle border border-2 border-dark" width="36" height="36" style="z-index:1">
                    </div>
                    <div class="small text-muted">
                        <strong class="text-white"><%= stats.total_users %>+</strong> professionals already on TalentForge
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="hero-card-stack">
                    <div class="card glass-card p-4 hero-float-card">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-success bg-opacity-25 rounded-circle p-2 me-3">
                                <i class="bi bi-check-circle-fill text-success fs-4"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-semibold">Project Completed</h6>
                                <small class="text-muted">E-commerce Platform</small>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Budget: $12,000</span>
                            <div class="text-warning">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card glass-card p-4 hero-float-card-2">
                        <div class="d-flex align-items-center">
                            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=sarah" class="rounded-circle me-3" width="48" height="48">
                            <div>
                                <h6 class="mb-0 fw-semibold">Sarah Chen</h6>
                                <small class="text-warning"><i class="bi bi-star-fill"></i> Top Rated — ML Engineer</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Bar -->
<section class="py-4 border-top border-bottom border-opacity-10" style="background: rgba(255,255,255,0.02)">
    <div class="container">
        <div class="row text-center">
            <div class="col-4">
                <h3 class="fw-bold text-warning mb-0"><%= stats.total_jobs %>+</h3>
                <small class="text-muted">Active Jobs</small>
            </div>
            <div class="col-4">
                <h3 class="fw-bold text-warning mb-0"><%= stats.total_users %>+</h3>
                <small class="text-muted">Freelancers</small>
            </div>
            <div class="col-4">
                <h3 class="fw-bold text-warning mb-0"><%= stats.total_applications %>+</h3>
                <small class="text-muted">Proposals Sent</small>
            </div>
        </div>
    </div>
</section>

<!-- Featured Jobs -->
<section class="py-5" id="featuredJobs">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Featured Projects</h2>
            <p class="text-muted">Top opportunities waiting for talented professionals like you</p>
        </div>
        <div class="row g-4">
            <% featuredJobs.forEach(job => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card job-card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-<%= job.job_type === 'fixed' ? 'primary' : 'info' %> bg-opacity-25 text-<%= job.job_type === 'fixed' ? 'primary' : 'info' %> small">
                                <%= job.job_type === 'fixed' ? 'Fixed Price' : 'Hourly' %>
                            </span>
                            <span class="badge bg-<%= job.experience_level === 'expert' ? 'danger' : job.experience_level === 'intermediate' ? 'warning' : 'success' %> bg-opacity-25 text-<%= job.experience_level === 'expert' ? 'danger' : job.experience_level === 'intermediate' ? 'warning' : 'success' %> small">
                                <%= job.experience_level.charAt(0).toUpperCase() + job.experience_level.slice(1) %>
                            </span>
                        </div>
                        <h5 class="card-title fw-semibold mb-2">
                            <a href="/jobs/<%= job.id %>" class="text-decoration-none stretched-link"><%= job.title %></a>
                        </h5>
                        <p class="card-text text-muted small mb-3"><%= job.description.substring(0, 120) %>...</p>
                        <div class="d-flex align-items-center mb-3">
                            <img src="<%= job.poster_avatar %>" class="rounded-circle me-2" width="24" height="24" alt="">
                            <small class="text-muted"><%= job.poster_name %></small>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-opacity-10">
                            <span class="fw-semibold text-success">$<%= Number(job.budget_min).toLocaleString() %> — $<%= Number(job.budget_max).toLocaleString() %></span>
                            <small class="text-muted"><%= job.category %></small>
                        </div>
                    </div>
                </div>
            </div>
            <% }); %>
        </div>
        <div class="text-center mt-5">
            <a href="/jobs" class="btn btn-outline-warning px-5">View All Jobs <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="py-5" style="background: rgba(255,255,255,0.02)">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">How TalentForge Works</h2>
            <p class="text-muted">Get started in three simple steps</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-center p-4">
                    <div class="feature-icon bg-warning bg-opacity-10 rounded-circle mx-auto mb-4">
                        <i class="bi bi-pencil-square text-warning fs-2"></i>
                    </div>
                    <h5 class="fw-semibold">1. Post a Job</h5>
                    <p class="text-muted small">Describe your project, set your budget, and specify the skills you need.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center p-4">
                    <div class="feature-icon bg-primary bg-opacity-10 rounded-circle mx-auto mb-4">
                        <i class="bi bi-people text-primary fs-2"></i>
                    </div>
                    <h5 class="fw-semibold">2. Receive Proposals</h5>
                    <p class="text-muted small">Talented freelancers submit proposals with their expertise and competitive rates.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-center p-4">
                    <div class="feature-icon bg-success bg-opacity-10 rounded-circle mx-auto mb-4">
                        <i class="bi bi-hand-thumbs-up text-success fs-2"></i>
                    </div>
                    <h5 class="fw-semibold">3. Hire & Collaborate</h5>
                    <p class="text-muted small">Choose the best match, manage your project, and pay securely through the platform.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Popular Categories</h2>
            <p class="text-muted">Browse by the most in-demand skills</p>
        </div>
        <div class="row g-3">
            <% const categories = [
                { name: 'Web Development', icon: 'bi-code-slash', color: 'primary' },
                { name: 'Mobile Development', icon: 'bi-phone', color: 'info' },
                { name: 'Design', icon: 'bi-palette', color: 'danger' },
                { name: 'Data Science', icon: 'bi-graph-up', color: 'success' },
                { name: 'DevOps', icon: 'bi-cloud', color: 'warning' },
                { name: 'Security', icon: 'bi-shield-check', color: 'info' },
                { name: 'Digital Marketing', icon: 'bi-megaphone', color: 'info' },
                { name: 'Technical Writing', icon: 'bi-file-text', color: 'secondary' }
            ]; %>
            <% categories.forEach(cat => { %>
            <div class="col-6 col-md-3">
                <a href="/jobs?q=<%= cat.name.split(' ')[0] %>" class="card category-card text-decoration-none h-100">
                    <div class="card-body text-center py-4">
                        <i class="bi <%= cat.icon %> fs-1 text-<%= cat.color %> mb-2 d-block"></i>
                        <h6 class="fw-semibold mb-0"><%= cat.name %></h6>
                    </div>
                </a>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
