<%- include('partials/header') %>
<% const pageTitle = profile.name; %>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card glass-card p-4 text-center">
                    <img src="<%= profile.avatar_url %>" class="rounded-circle mx-auto mb-3" width="120" height="120" alt="<%= profile.name %>">
                    <h4 class="fw-bold mb-1"><%= profile.name %></h4>
                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1"></i><%= profile.location || 'Remote' %></p>
                    <% if (profile.hourly_rate > 0) { %>
                    <h5 class="text-success fw-bold mb-3">$<%= Number(profile.hourly_rate).toFixed(0) %>/hr</h5>
                    <% } %>
                    <% if (profile.skills) { %>
                    <div class="d-flex flex-wrap gap-1 justify-content-center mb-3">
                        <% profile.skills.split(',').forEach(skill => { %>
                        <span class="badge bg-warning bg-opacity-10 text-warning small"><%= skill.trim() %></span>
                        <% }); %>
                    </div>
                    <% } %>
                    <div class="d-grid gap-2 mt-3">
                        <% if (user && user.id !== profile.id) { %>
                        <a href="#" class="btn btn-warning fw-semibold" onclick="startMessage(<%= profile.id %>)">
                            <i class="bi bi-chat-dots me-1"></i> Send Message
                        </a>
                        <% } %>
                        <% if (user && user.id == profile.id) { %>
                        <a href="/profile/edit" class="btn btn-outline-warning fw-semibold">
                            <i class="bi bi-pencil me-1"></i> Edit Profile
                        </a>
                        <% } %>
                    </div>
                    <div class="mt-4 pt-3 border-top border-opacity-10">
                        <small class="text-muted">
                            <i class="bi bi-calendar me-1"></i>Member since <%= new Date(profile.created_at).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %>
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <!-- Bio - rendered through ejs.render for SSTI -->
                <div class="card glass-card p-4 mb-4">
                    <h5 class="fw-semibold mb-3"><i class="bi bi-person-lines-fill me-2 text-warning"></i>About</h5>
                    <div class="text-muted" style="white-space: pre-wrap;"><%- renderedBio %></div>
                </div>

                <!-- Jobs posted by this user -->
                <% if (jobs && jobs.length > 0) { %>
                <div class="card glass-card p-4 mb-4">
                    <h5 class="fw-semibold mb-3"><i class="bi bi-briefcase me-2 text-warning"></i>Posted Jobs</h5>
                    <% jobs.forEach(job => { %>
                    <div class="d-flex justify-content-between align-items-center p-3 rounded mb-2" style="background: rgba(255,255,255,0.03)">
                        <div>
                            <a href="/jobs/<%= job.id %>" class="fw-semibold text-decoration-none"><%= job.title %></a>
                            <div class="text-muted small mt-1">
                                <span class="badge bg-<%= job.status === 'open' ? 'success' : 'secondary' %> bg-opacity-25 text-<%= job.status === 'open' ? 'success' : 'secondary' %> small"><%= job.status %></span>
                                <span class="ms-2">$<%= Number(job.budget_min).toLocaleString() %> — $<%= Number(job.budget_max).toLocaleString() %></span>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } %>

                <!-- Reviews - rendered with unescaped EJS -->
                <div class="card glass-card p-4">
                    <h5 class="fw-semibold mb-3"><i class="bi bi-star me-2 text-warning"></i>Reviews (<%= reviews.length %>)</h5>
                    <% if (reviews.length === 0) { %>
                    <p class="text-muted">No reviews yet.</p>
                    <% } %>
                    <% reviews.forEach(review => { %>
                    <div class="review-item p-3 rounded mb-3" style="background: rgba(255,255,255,0.03)">
                        <div class="d-flex align-items-center mb-2">
                            <img src="<%= review.reviewer_avatar %>" class="rounded-circle me-2" width="36" height="36" alt="">
                            <div>
                                <a href="/profile/<%= review.reviewer_id %>" class="fw-semibold text-decoration-none small"><%= review.reviewer_name %></a>
                                <div class="text-warning small">
                                    <% for (let i = 0; i < review.rating; i++) { %><i class="bi bi-star-fill"></i><% } %>
                                    <% for (let i = review.rating; i < 5; i++) { %><i class="bi bi-star"></i><% } %>
                                </div>
                            </div>
                            <small class="text-muted ms-auto"><%= new Date(review.created_at).toLocaleDateString() %></small>
                        </div>
                        <p class="text-muted small mb-0"><%- review.body %></p>
                    </div>
                    <% }); %>

                    <% if (user && user.id !== profile.id) { %>
                    <hr class="opacity-25">
                    <h6 class="fw-semibold mb-3">Leave a Review</h6>
                    <form id="reviewForm">
                        <div class="mb-3">
                            <label class="form-label small">Rating</label>
                            <select class="form-select" id="reviewRating" required>
                                <option value="5">★★★★★ Excellent</option>
                                <option value="4">★★★★ Great</option>
                                <option value="3">★★★ Good</option>
                                <option value="2">★★ Fair</option>
                                <option value="1">★ Poor</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small">Review</label>
                            <textarea class="form-control" id="reviewBody" rows="3" placeholder="Share your experience..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-warning btn-sm fw-semibold">Submit Review</button>
                    </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
async function startMessage(recipientId) {
    try {
        const res = await fetch('/api/v1/messages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ recipient_id: recipientId, content: 'Hi! I would like to connect with you.' })
        });
        const data = await res.json();
        if (res.ok) {
            window.location.href = '/messages/' + data.thread_id;
        }
    } catch (err) {
        alert('Failed to send message. Please log in first.');
    }
}

const reviewForm = document.getElementById('reviewForm');
if (reviewForm) {
    reviewForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        try {
            const res = await fetch('/api/v1/reviews', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    reviewee_id: <%= profile.id %>,
                    rating: document.getElementById('reviewRating').value,
                    body: document.getElementById('reviewBody').value
                })
            });
            const data = await res.json();
            if (res.ok) {
                window.location.reload();
            } else {
                alert(data.error);
            }
        } catch (err) {
            alert('Failed to submit review');
        }
    });
}
</script>

<%- include('partials/footer') %>
